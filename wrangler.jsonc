{
  // Landing en Cloudflare Workers: archivos estáticos de public/ + servidor de pagos ePayco (worker/index.js).
  // Las llaves de ePayco se guardan como variables/secretos en el panel de Cloudflare (ver README).
  "name": "cursosia",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
